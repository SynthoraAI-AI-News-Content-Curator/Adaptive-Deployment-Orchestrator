# Application Configuration
APP_NAME="Adaptive Deployment Orchestrator"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# API Configuration
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security - CHANGE THIS IN PRODUCTION!
SECRET_KEY=your-secret-key-min-32-characters-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://ado_user:ado_pass@localhost:5432/ado_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Prometheus Metrics
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_ENABLED=true

# Kubernetes Integration
K8S_ENABLED=false
K8S_CONFIG_PATH=
K8S_NAMESPACE=default

# Deployment Defaults
DEFAULT_HEALTH_CHECK_INTERVAL=30
DEFAULT_METRIC_CHECK_INTERVAL=15
DEFAULT_ROLLBACK_TIMEOUT=300

# Anomaly Detection
ANOMALY_DETECTION_ENABLED=true
ANOMALY_WINDOW_SIZE=50
ANOMALY_THRESHOLD=2.5

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=true
OTEL_ENDPOINT=http://localhost:4318

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MESSAGE_QUEUE_SIZE=1000
